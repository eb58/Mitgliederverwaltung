{
  "name": "mitgliederverwaltung",
  "version": "1.0.0",
  "description": "Webbasierte Mitgliederverwaltung Senioren Lübars",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:php && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.js",
    "test:unit:watch": "node --test --watch tests/unit/*.test.js",
    "test:php": "node tests/tools/ensure-phpunit.mjs && node tests/tools/ensure-test-db.mjs && php tests/tools/phpunit.phar --configuration tests/phpunit.xml",
    "test:php:db:up": "docker compose -f tests/docker-compose.test.yml up -d --wait",
    "test:php:db:down": "docker compose -f tests/docker-compose.test.yml down -v",
    "test:e2e": "playwright test --config tests/playwright.config.js",
    "test:e2e:ui": "playwright test --config tests/playwright.config.js --ui",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "ag-grid-community": "^35.3.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1"
  }
}
