RewriteEngine On

# Muss vor den [L]-Regeln stehen: reicht Authorization als REDIRECT_HTTP_AUTHORIZATION
# an PHP durch, das ihn unter FastCGI/CGI sonst nicht sieht.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Ohne mod_headers ignoriert Apache den Block, statt mit 500 zu antworten.
# Das unset vor jedem set haelt den Wert eindeutig: sonst steht bei einer intern
# aufgeloesten Anfrage (index.php/health) jeder Header doppelt in der Antwort.
<IfModule mod_headers.c>
  Header always unset X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"
  Header always unset X-Frame-Options
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteRule ^api(/.*)?$ index.php [QSA,L]
RewriteRule ^health$ index.php [QSA,L]

SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Falls der Hoster es erlaubt (Apache >= 2.4.13, AllowOverride FileInfo), ist das
# der sauberste Weg - bei fehlender Freigabe antwortet Apache mit 500:
# CGIPassAuth On
