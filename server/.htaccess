RewriteEngine On

# Muss vor den [L]-Regeln stehen: reicht Authorization als REDIRECT_HTTP_AUTHORIZATION
# an PHP durch, das ihn unter FastCGI/CGI sonst nicht sieht.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Ohne mod_headers ignoriert Apache den Block, statt mit 500 zu antworten.
# Bewusst ohne "always": das schreibt in err_headers_out, und diese Tabelle
# ueberlebt die interne Aufloesung von index.php/health - der Header stuende dann
# doppelt in der Antwort. Ohne "always" gilt er fuer jede Antwort, die PHP selbst
# erzeugt, einschliesslich der Fehlerstatus der API; nur von Apache selbst
# erzeugte Fehlerseiten bleiben aussen vor.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteRule ^api(/.*)?$ index.php [QSA,L]
RewriteRule ^health$ index.php [QSA,L]

SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Falls der Hoster es erlaubt (Apache >= 2.4.13, AllowOverride FileInfo), ist das
# der sauberste Weg - bei fehlender Freigabe antwortet Apache mit 500:
# CGIPassAuth On
